<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ApplicationIcon>..\..\assets\brand\soul-computer-use.ico</ApplicationIcon>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SoulComputerUse.Core\SoulComputerUse.Core.csproj" />
    <ProjectReference Include="..\SoulComputerUse.Windows\SoulComputerUse.Windows.csproj" />

    <!-- Both executables are started from this program's own directory and never from PATH: the agent
         becomes the child session's alternate shell, and the helper is the only program this product
         elevates. Copying them beside the host is what makes that derivation true in a build output. -->
    <ProjectReference Include="..\SoulComputerUse.SessionAgent\SoulComputerUse.SessionAgent.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>Content</OutputItemType>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </ProjectReference>
    <ProjectReference Include="..\SoulComputerUse.ChildSessionsHelper\SoulComputerUse.ChildSessionsHelper.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <OutputItemType>Content</OutputItemType>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </ProjectReference>
  </ItemGroup>

</Project>